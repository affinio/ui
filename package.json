{
  "name": "affino-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": "^24.0.0"
  },
  "workspaces": [
    "packages/*",
    "demo-vue",
    "demo-laravel"
  ],
  "scripts": {
    "bootstrap": "node ./scripts/bootstrap.mjs",
    "dev": "pnpm --filter demo-vue dev",
    "build": "pnpm -r --if-present build",
    "type-check": "pnpm -r --if-present type-check",
    "type-check:tests": "node ./scripts/type-check-tests.mjs",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm -r --if-present format",
    "test": "pnpm -r --if-present test",
    "test:vue-matrix": "pnpm --filter @affino/dialog-vue test && pnpm --filter @affino/menu-vue test && pnpm --filter @affino/popover-vue test && pnpm --filter @affino/tooltip-vue test && pnpm --filter @affino/selection-vue test && pnpm --filter @affino/combobox-vue test && pnpm --filter @affino/treeview-vue test && pnpm --filter @affino/vue-adapter test",
    "test:unit": "pnpm -r --if-present test",
    "test:matrix:unit": "pnpm run test:unit",
    "test:matrix:interaction": "pnpm run smoke:components:demo && pnpm run smoke:treeview:demo && pnpm run test:diagram:browser",
    "test:matrix:visual": "pnpm --filter @affino/visual-workbench test:visual",
    "check": "pnpm run lint && pnpm run type-check && pnpm run test",
    "quality:deps:workspace-internal": "node ./scripts/check-internal-workspace-deps.mjs",
    "quality:metadata:packages": "node ./scripts/check-package-metadata.mjs",
    "fix:deps:workspace-internal": "node ./scripts/check-internal-workspace-deps.mjs --write",
    "fix:metadata:packages": "node ./scripts/check-package-metadata.mjs --write",
    "scaffold:adapter-triad": "node ./scripts/scaffold-adapter-triad.mjs",
    "bench:laravel-morph": "node ./scripts/bench-livewire-morph.mjs",
    "bench:laravel-morph:assert": "PERF_BUDGET_TOTAL_MS=3400 PERF_BUDGET_MAX_HYDRATE_RATE_PCT=25 PERF_BUDGET_MAX_BOOTSTRAP_MS=12 PERF_BUDGET_MAX_OPEN_CLOSE_MS=2 node ./scripts/bench-livewire-morph.mjs",
    "bench:vue-adapters": "node --expose-gc ./scripts/bench-vue-adapters.mjs",
    "bench:vue-adapters:assert": "PERF_BUDGET_TOTAL_MS=1400 PERF_BUDGET_MAX_BOOTSTRAP_MS=8 PERF_BUDGET_MAX_CONTROLLER_MS=30 PERF_BUDGET_MAX_RELAYOUT_MS=6 node --expose-gc ./scripts/bench-vue-adapters.mjs",
    "bench:treeview:core": "node --expose-gc --experimental-specifier-resolution=node ./scripts/bench-treeview-core.mjs",
    "bench:treeview:core:assert": "BENCH_TREEVIEW_NODE_COUNT=10000 BENCH_TREEVIEW_SAMPLE_COUNT=5 BENCH_TREEVIEW_BURST_ITERATIONS=400 PERF_BUDGET_TOTAL_MS=24000 PERF_BUDGET_MAX_REGISTER_REPLACE_P95_MS=120 PERF_BUDGET_MAX_REGISTER_PATCH_P95_MS=140 PERF_BUDGET_MAX_FOCUS_BURST_P95_MS=200 PERF_BUDGET_MAX_SELECT_BURST_P95_MS=90 PERF_BUDGET_MAX_VISIBLE_READ_P95_MS=80 PERF_BUDGET_MAX_HEAP_DELTA_MB=120 node --expose-gc --experimental-specifier-resolution=node ./scripts/bench-treeview-core.mjs",
    "bench:treeview:vue:virtual": "node --expose-gc ./scripts/bench-treeview-vue-virtual.mjs",
    "bench:treeview:vue:virtual:assert": "BENCH_TREEVIEW_NODE_COUNT=10000 BENCH_TREEVIEW_SCROLL_STEPS=160 BENCH_TREEVIEW_SAMPLE_COUNT=3 PERF_BUDGET_TOTAL_MS=8000 PERF_BUDGET_MAX_SCROLL_P95_MS=600 PERF_BUDGET_MAX_BLANK_VIEWPORTS=0 PERF_BUDGET_MAX_HEAP_DELTA_MB=160 node --expose-gc ./scripts/bench-treeview-vue-virtual.mjs",
    "smoke:treeview:demo": "node ./scripts/smoke-treeview-demo.mjs",
    "smoke:components:demo": "node ./scripts/smoke-components-demo.mjs",
    "bench:components:ci": "pnpm --filter @affino/treeview-core bench:assert && pnpm --filter @affino/dialog-core bench && BENCH_DIAGRAM_ENTITY_COUNTS=1000,5000,10000 node --expose-gc ./scripts/bench-diagram-core.mjs",
    "quality:components:esm": "node ./scripts/check-components-esm-specifiers.mjs",
    "quality:max": "node ./scripts/quality-max-pipeline.mjs",
    "test:diagram:browser": "node ./scripts/smoke-diagram-connectors.mjs && node ./scripts/accept-diagram-table.mjs && node ./scripts/smoke-diagram-drag-preview.mjs",
    "quality:workspace:references": "node ./scripts/check-workspace-quality-references.mjs",
    "release:check:package": "node ./scripts/check-package-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vue/tsconfig": "^0.8.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.3.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue": "3.4.38",
    "vue-tsc": "^3.2.5"
  }
}
