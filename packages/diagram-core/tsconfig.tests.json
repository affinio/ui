{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2019",
      "ES2022.Array",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "types": [
      "vitest/globals",
      "vite/client"
    ],
    "rootDir": "../..",
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/__tests__/**/*.ts",
    "**/__tests__/**/*.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "coverage"
  ]
}
