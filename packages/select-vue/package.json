{
  "name": "@affino/select-vue",
  "version": "0.1.0",
  "author": "Anton Pavlov <a.pavlov@affino.dev>",
  "type": "module",
  "description": "Accessible single-value Select component for Vue 3",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./styles.css": "./dist/styles.css" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "peerDependencies": { "vue": "^3.3.0" },
  "dependencies": { "@affino/listbox-core": "workspace:^", "@affino/popover-vue": "workspace:^" },
  "scripts": { "clean": "rm -rf dist tsconfig.build.tsbuildinfo", "build": "pnpm run clean && vite build && pnpm run build:types", "build:types": "vue-tsc --build tsconfig.build.json", "test": "vitest run" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/affinio/affinio.git", "directory": "packages/select-vue" },
