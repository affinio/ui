  "bugs": { "url": "https://github.com/affinio/affinio/issues" },
  "keywords": ["affino", "vue", "vue3", "select", "listbox", "accessibility"],
  "devDependencies": { "@vitejs/plugin-vue": "^6.0.4", "@vue/test-utils": "^2.4.6", "jsdom": "^28.1.0", "vite": "^7.3.1", "vitest": "^4.0.15", "vue": "^3.4.0" }
}
